# Select one profile: ollama, deepseek, or custom.
CODE_AGENT_PROVIDER=ollama

# Local Ollama profile.
OLLAMA_MODEL_ID=deepseek-r1:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=180

# DeepSeek OpenAI-compatible profile.
DEEPSEEK_MODEL_ID=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT=180

# Offline note vectors. Switch to openai_compatible for semantic embeddings.
CODE_AGENT_EMBEDDING_PROVIDER=local_hash
CODE_AGENT_EMBEDDING_MODEL=feature-hash-v1
CODE_AGENT_EMBEDDING_BASE_URL=
CODE_AGENT_EMBEDDING_API_KEY=
CODE_AGENT_EMBEDDING_DIMENSIONS=384

# Restricted subprocess backend. Keep this allowlist read-only.
CODE_AGENT_TERMINAL_ENABLED=1
CODE_AGENT_TERMINAL_ALLOWED_PROGRAMS=rg
CODE_AGENT_TERMINAL_TIMEOUT=15
CODE_AGENT_TERMINAL_MAX_STDOUT_BYTES=8000000

# Optional runtime settings.
CODE_AGENT_PORT=8765
CODE_AGENT_MAX_STEPS=10
CODE_AGENT_RELEVANT_NOTES=5
CODE_AGENT_MAX_FILE_LINES=160
CODE_AGENT_MAX_MATCHES=50
CODE_AGENT_MAX_FILES=120
CODE_AGENT_MAX_FILE_BYTES=1500000
CODE_AGENT_SEARCH_TIMEOUT=15
